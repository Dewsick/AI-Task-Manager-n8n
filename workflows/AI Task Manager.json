      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  let output = item.json.output;\n  \n\n  try {\n    if (typeof output === 'string') {\n      output = output\n        .replace(/```json\\s*/gi, '')\n        .replace(/```\\s*/g, '')\n        .trim();\n\n      output = JSON.parse(output);\n    }\n\n    if (!output || typeof output !== 'object') {\n      throw new Error('AI вернул некорректный формат');\n    }\n\n    return {\n      json: {\n        task: output.task ?? null,\n        priority: output.priority ?? 'normal',\n        date: output.date ?? null,\n        time: output.time ?? null,\n        category: output.category ?? 'Другое'\n      }\n    };\n\n  } catch (error) {\n    throw new Error('Не удалось распознать ответ AI Agent');\n  }\n});"
      },
