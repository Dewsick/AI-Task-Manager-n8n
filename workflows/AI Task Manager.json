    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst taskNumber = Number(\n  $('Edit Fields').first().json.taskNumber\n);\n\nif (!taskNumber || Number(taskNumber) < 1) {\n  return [{\n    json: {\n      found: false,\n      message: '❌ Укажите номер задачи. Например: /done 2'\n    }\n  }];\n}\n\nconst activeTasks = items.filter(\n  item => item.json.status === 'Активная'\n);\n\nconst task = activeTasks[taskNumber - 1];\n\nif (!task) {\n  return [{\n    json: {\n      found: false,\n      message: `❌ Задача №${taskNumber} не найдена.`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    found: true,\n    rowId: task.json.id,\n    taskNumber: taskNumber,\n    task: task.json.task\n  }\n}];"
      },
