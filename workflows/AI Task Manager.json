    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst rawTaskId = $('delete').first().json.taskId;\n\nif (rawTaskId !== null && rawTaskId !== undefined) {\n  const taskId = Number(rawTaskId);\n\n  if (Number.isNaN(taskId)) {\n    return [{\n      json: {\n        found: false,\n        message: '❌ ID задачи должен быть числом.'\n      }\n    }];\n  }\n\n  for (const item of items) {\n    if (String(item.json.id) === String(taskId)) {\n      return [{\n        json: {\n          found: true,\n          deleteMode: 'single',\n          rowId: item.json.id,\n          task: item.json.task\n        }\n      }];\n    }\n  }\n\n  return [{\n    json: {\n      found: false,\n      message: `❌ Задача с ID ${taskId} не найдена.`\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        -624
      ],
      "id": "f4bcd392-ad87-4192-8101-6c8a1cde2b5e",
      "name": "Code delete",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst today = new Date()\n  .toLocaleDateString('en-CA', {\n    timeZone: 'Europe/Moscow'\n  });\n\nconst tasks = items\n  .filter(item => {\n    const task = item.json;\n\n    return (\n      task.status === 'Активная' &&\n      task.date === today\n    );\n  })\n  .map((item, index) => {\n    const task = item.json;\n\n    return `ID: ${task.id}. ${task.task}\n📅 ${task.date || 'Без даты'}${task.time ? ` в ${task.time}` : ''}\n📌 ${task.priority}\n🏷 ${task.category}`;\n\nreturn [{\n  json: {\n    message: tasks.length\n      ? `📅 Задачи на сегодня:\\n\\n${tasks.join('\\n\\n')}`\n      : '📅 На сегодня активных задач нет.'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -464
      ],
      "id": "8fb348e5-0647-4403-958a-6f5d60fbbb68",
      "name": "Code today"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{\n    json: {\n      message: '📋 Задач пока нет.'\n    }\n  }];\n}\n\nconst tasks = items\n  .filter(item => item.json.status === 'Активная')\n  .map((item) => {\n    const task = item.json;\n\n    return `ID: ${task.id}. ${task.task}\n📅 ${task.date || 'Без даты'}${task.time ? ` в ${task.time}` : ''}\n📌 ${task.priority}\n🏷 ${task.category}`;\n  });\n\nreturn [{\n  json: {\n    message: tasks.length\n      ? `📋 Активные задачи:\\n\\n${tasks.join('\\n\\n')}`\n      : '📋 Активных задач нет.'\n  }\n}];"
      },
