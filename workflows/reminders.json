    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst now = new Date();\nconst result = [];\n\nfor (const item of items) {\n  const task = item.json;\n\n  if (task.status !== 'Активная') continue;\n  if (task.notified === true) continue;\n  if (!task.date) continue;\n\n  let reminderTime = task.reminder_time || task.time;\n  let needsReminderTime = false;\n\n  // Если пользователь не указал время\n  // и случайное время ещё не было сохранено\n  if (!task.time && !task.reminder_time) {\n    const start = 18 * 60;\n    const end = 22 * 60;\n\n    const randomMinutes =\n      start + Math.floor(Math.random() * (end - start + 1));\n\n    const hours = Math.floor(randomMinutes / 60);\n    const minutes = randomMinutes % 60;\n\n    reminderTime =\n      `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;\n\n    needsReminderTime = true;\n  }\n\n  const taskDate = new Date(\n    `${task.date}T${reminderTime}:00+03:00`\n  );\n\n  if (Number.isNaN(taskDate.getTime())) continue;\n\n  result.push({\n    json: {\n      ...task,\n      reminder_time: reminderTime,\n      needs_reminder_time: needsReminderTime,\n      reminder_due: taskDate <= now\n    }\n  });\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
